# ローカルの Edge Functions 用(supabase start が読む)。コピーして supabase/.env を作る。実際の値をコミットしない
BUDDYSHIP_LOG_HASH_SALT=change-me-local-only
BUDDYSHIP_SITE_URL=http://127.0.0.1:5173
BUDDYSHIP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BUDDYSHIP_AI_PROVIDER=mock
# 画像の定期削除ジョブの呼び出し用(32 文字以上。ローカル専用の値)
BUDDYSHIP_PURGE_JOB_SECRET=local-only-purge-secret-0123456789abcdef
